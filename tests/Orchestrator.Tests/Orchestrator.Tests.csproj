<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgenticUrlShortener.Orchestrator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- See Service.Tests.csproj: sandbox IPv6 egress quirk workaround. -->
